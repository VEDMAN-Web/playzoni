# Copy to .env (gitignored) and fill in. Never commit real values.
PUBLIC_SITE_URL=
PUBLIC_CF_ANALYTICS_TOKEN=
PUBLIC_ADS_ENABLED=
PUBLIC_ADSENSE_CLIENT=
PUBLIC_INCLUDE_SAMPLES=
# Owner preview only: true shows draft games and noindexes every page. Never on the main branch (the build refuses).
PUBLIC_INCLUDE_DRAFTS=
GD_FEED_URL=
# GameMonetize feed address, for example the JSON feed with format=0 and num=50 (add --pages N to import more pages).
GM_FEED_URL=
# Playgama catalog: a web address, or the path of a saved catalog file such as data/playgama.json (git-ignored).
PG_FEED_URL=
GP_FEED_URL=
# Highest priority first, for example gm,pg. Used when two providers have the same game title.
SOURCE_PRIORITY=

# Phase 10 (docs/ADMIN.md): our own anonymous measurement (true = on) and the admin instant settings applier (true = on). Off by default.
PUBLIC_TRACKING_ENABLED=
PUBLIC_ADMIN_CONFIG_ENABLED=
