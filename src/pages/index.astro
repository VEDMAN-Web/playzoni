---
import { categoryPictures } from '../lib/category-image';
import { previewFields } from '../lib/preview';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GameGrid, { type GridGame, type GridItem } from '../components/GameGrid.astro';
import ShowMore from '../components/ShowMore.astro';
import MoreRows from '../components/MoreRows.astro';
import RecentlyPlayed from '../components/RecentlyPlayed.astro';
import SeoCard from '../components/SeoCard.astro';
import JsonLd from '../components/JsonLd.astro';
import { pickBadges } from '../lib/badges';
import { getPublishedGames } from '../lib/games';
import { dayNumber, upcomingPicks } from '../lib/game-of-day';
import { publishedCategoriesFrom } from '../lib/published';

// Home page in the order of docs/PRD.md §6. Recently played (T2.6) goes between the mosaic and the rows.
const title = 'Playzoni | Play Free Online Games Instantly';
const description =
  'Play free online games instantly on Playzoni. No download and no sign-up needed. Browse action, car, puzzle, sports and more browser games.';

const games = await getPublishedGames();
// Only categories with at least 12 published games are linked.
const published = publishedCategoriesFrom(games);

// One picture per category, never the same game twice on a page (R33).
const pictures = categoryPictures(games, published);

const byPopularity = [...games].sort((a, b) => b.data.popularity - a.data.popularity);

// Badges (docs/DESIGN.md §V2.2): New = added within 7 days and among the newest 8 games; Hot = top 10 by popularity.
// One badge per game; the grid draws at most 12 on the page.
const badges = pickBadges(
  games.map((g) => ({ slug: g.data.slug, addedDate: g.data.addedDate, popularity: g.data.popularity })),
  Date.now(),
);

const gameItem = (g: (typeof games)[number]): GridGame => ({
  kind: 'game',
  title: g.data.title,
  slug: g.data.slug,
  featured: g.data.featured,
  badge: badges.get(g.data.slug),
  ...previewFields(g.data),
});

// T9.5 Game of the day: today's pick (UTC) at build time, plus the next 13 days for the swap script below.
const dayPicks = upcomingPicks(
  games.filter((g) => g.data.mobile).map((g) => ({ slug: g.data.slug, title: g.data.title })),
  dayNumber(Date.now()),
);
const godSlug = dayPicks[0]?.slug;

// Mosaic: up to 90 popular games. The nav categories go in after tile 36 (DESIGN §Category tile).
// The Game of the day is an L tile right after the featured games (it is marked featured so the mosaic gives it the
// next L slot), and it is not repeated elsewhere in the mosaic.
const popularItems: GridItem[] = byPopularity.filter((g) => g.data.slug !== godSlug).slice(0, godSlug ? 89 : 90).map(gameItem);
const godGame = games.find((g) => g.data.slug === godSlug);
const lastFeatured = popularItems.reduce((last, item, i) => (item.kind === 'game' && item.featured ? i : last), -1);
const mosaicGames: GridItem[] = godGame
  ? [
      ...popularItems.slice(0, lastFeatured + 1),
      { ...gameItem(godGame), featured: true, badge: undefined, pill: 'Game of the day' },
      ...popularItems.slice(lastFeatured + 1),
    ]
  : popularItems;
const navCategoryItems: GridItem[] = published
  .filter((c) => c.navOrder !== null)
  .sort((a, b) => (a.navOrder ?? 0) - (b.navOrder ?? 0))
  .map((c) => ({ kind: 'category' as const, slug: c.slug, shortName: c.shortName, emoji: c.emoji, imageSlug: pictures.get(c.slug) }));
const mosaicItems: GridItem[] =
  mosaicGames.length > 36
    ? [...mosaicGames.slice(0, 36), ...navCategoryItems, ...mosaicGames.slice(36)]
    : mosaicGames;

// "Top games" in the text card: the five most popular published games.
const topGames = byPopularity.slice(0, 5).map((g) => ({ title: g.data.title, slug: g.data.slug }));
const topEight = published
  .filter((c) => c.navOrder !== null && c.navOrder <= 8)
  .sort((a, b) => (a.navOrder ?? 0) - (b.navOrder ?? 0));
// Popular categories list in the text block: one line each, taken from the category intro.
const firstSentence = (text: string): string => text.split(/(?<=\.)\s/)[0];
const popularLinks = topEight.map((c) => ({ slug: c.slug, name: c.name, emoji: c.emoji, line: firstSentence(c.intro) }));

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Playzoni',
  url: 'https://playzoni.com',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://playzoni.com/search?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
// SEO-PLAN §Schema: the site's organisation is Playzoni, published by SparkBeta Tech.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Playzoni',
  url: 'https://playzoni.com',
  logo: 'https://playzoni.com/icon-512.png',
  parentOrganization: { '@type': 'Organization', name: 'SparkBeta Tech' },
};

// Home FAQ (DESIGN §V2.11): shown in the text card and repeated as FAQPage data. Answers are plain text.
const faqs: { q: string; a: string }[] = [
  {
    q: 'Are the games on Playzoni free?',
    a: 'Yes. Every game is free to play in your browser. Some games show a short ad now and then, and those ads pay for the site.',
  },
  {
    q: 'Do I need to download or install anything?',
    a: 'No. Pick a game and press Play. It opens inside the page in a few seconds, on any modern browser.',
  },
  {
    q: 'Do I need an account to play?',
    a: 'No account is needed. Your favourites and recently played games are saved in your browser on this device, so they are there when you come back.',
  },
  {
    q: 'Can I play on my phone or tablet?',
    a: 'Yes. We pick games that work on phones. On a phone the game opens full screen; if it asks you to turn your phone sideways, rotate it and play.',
  },
  {
    q: 'Can I play with a friend?',
    a: 'Yes. The 2 Player Games category has games for two people on one screen or one keyboard, and some games let you play online with others.',
  },
  {
    q: 'How do I save a game I like?',
    a: 'Tap the heart under the game. You will find it again on the Favourites page, which you can open from the heart button at the top.',
  },
  {
    q: 'How often are new games added?',
    a: 'We add new games regularly. The New Games page always shows the latest ones first.',
  },
  {
    q: 'A game is not loading. What can I do?',
    a: 'Reload the page and check your internet connection, or try another browser. If it still does not work, use the report button under the game and we will look at it.',
  },
];
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout title={title} description={description} canonicalPath="/" mainClass="has-grid">
  <Header slot="header" box={false} />

  <GameGrid items={mosaicItems} mode="mosaic" navBox={true} xlFirst={true} eagerCount={1} label="Popular and featured games" />
  {dayPicks.length > 0 && <script type="application/json" id="pz-god" set:html={JSON.stringify(dayPicks)} />}
  <script is:inline>
    // T9.5: the page was built on one day; show today's Game of the day (UTC) in the same tile. If today's game is
    // elsewhere in the mosaic, the two tiles trade games, so nothing is shown twice and nothing moves.
    (function () {
      try {
        const data = document.getElementById('pz-god');
        const tile = document.querySelector('main .grid-mosaic a.tile[data-pill]');
        if (!data || !tile) return;
        const d = Math.floor((Date.now() - Date.UTC(2026, 0, 1)) / 86400000);
        const pick = JSON.parse(data.textContent).find(function (p) { return p.d === d; });
        if (!pick || pick.slug === tile.dataset.slug) return;
        const other = document.querySelector('main .grid-mosaic a.tile[data-slug="' + pick.slug + '"]');
        const put = function (a, slug, title) {
          const old = a.dataset.slug;
          a.href = '/game/' + slug;
          a.dataset.slug = slug;
          const img = a.querySelector('img');
          ['src', 'srcset'].forEach(function (k) {
            const v = img.getAttribute(k);
            if (v) img.setAttribute(k, v.split('/thumbs/' + old + '/').join('/thumbs/' + slug + '/'));
          });
          const name = a.querySelector('.overlay-text');
          if (name) name.textContent = title;
          const badge = a.querySelector('.badge');
          if (badge) badge.remove();
        };
        const oldSlug = tile.dataset.slug;
        const oldTitle = (tile.querySelector('.overlay-text') || {}).textContent || '';
        put(tile, pick.slug, pick.title);
        if (other) put(other, oldSlug, oldTitle);
      } catch {
        /* keep the build-day pick */
      }
    })();
  </script>
  <ShowMore />

  <RecentlyPlayed />

  <MoreRows />

  <SeoCard label="About Playzoni" wide>
    <div class="about-intro">
      <h1>Free Online Games on Playzoni</h1>
      <p class="lead">
        Play <strong>free online games</strong> in your browser. Pick a game, press Play, and it starts straight away,
        with <strong>nothing to download</strong> and <strong>no account</strong> to make.
      </p>
      <ul class="perks" aria-label="Why play on Playzoni">
        <li><span aria-hidden="true">✓</span> Free to play</li>
        <li><span aria-hidden="true">✓</span> No download</li>
        <li><span aria-hidden="true">✓</span> Phone, tablet and computer</li>
      </ul>
    </div>

    <div class="about-cols">
      <div class="about-text">
        <h2>Play instantly on any device</h2>
        <p>
          Every game runs on phones, tablets, laptops and desktop computers. On a phone you tap the screen to play. On a
          computer you use the mouse and keyboard, as the game asks. Games open inside the page, and you can switch to full
          screen when you want more room.
        </p>
        <p>
          Start with the easy games at the top of this page: <strong>one tap or one swipe</strong> is all you need. When
          you want more, every category has deeper games to try.
        </p>

        <h2>How we pick games</h2>
        <p>
          We choose games that <strong>load quickly</strong>, work well with touch screens and keyboards, and stay fun for
          more than a few seconds. Every game page has text we wrote ourselves, never the text that comes with the game.
        </p>
        <p>
          If a game stops working, press Report under it and we fix it or take it down. The Popular row is sorted by
          popularity, the New row shows the latest games, and each category row shows its most popular games first.
        </p>
      </div>

      <div class="about-side">
        <h2>Popular categories</h2>
        <ul class="cat-list">
          {popularLinks.map((c) => (
            <li>
              <a href={`/${c.slug}`}>
                <span class="cat-icon" aria-hidden="true">{c.emoji}</span>
                <span class="cat-text">
                  <span class="cat-name">{c.name}</span>
                  <span class="cat-line">{c.line}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>

        {topGames.length > 0 && (
          <>
            <h2>Top games</h2>
            <ol class="top-list">
              {topGames.map((g, i) => (
                <li>
                  <a href={`/game/${g.slug}`}>
                    <span class="top-rank" aria-hidden="true">{i + 1}</span>
                    <img src={`/thumbs/${g.slug}/s.webp`} alt="" width="40" height="40" loading="lazy" decoding="async" />
                    <span class="top-name">{g.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </>
        )}
      </div>
    </div>

    <h2 class="faq-heading">Questions and answers</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </SeoCard>

  <JsonLd data={[website, organization, faqPage]} />
  <Footer slot="footer" />
</BaseLayout>

<style>

  /* Text card layout (DESIGN §V2.11): centred intro, then two columns from 1024px, then the FAQ. */
  .about-intro {
    padding-bottom: var(--s-5);
    border-bottom: 1px solid var(--c-line);
  }
  .about-intro .lead {
    max-width: 760px;
    margin: 0 0 var(--s-4);
    font: 400 18px/28px var(--font-sans);
  }
  .about-intro .perks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .about-intro .perks li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 6px 14px;
    border-radius: var(--r-pill);
    background: var(--c-bg);
    color: var(--c-ink);
    font: var(--t-small);
  }
  .perks span {
    color: var(--c-primary-dark);
    font-weight: 800;
  }
  .about-cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 var(--s-7);
  }
  @media (min-width: 1024px) {
    .about-cols {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
  }
  .about-side .cat-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 600px) {
    .about-side .cat-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .about-side .cat-list li {
    margin: 0;
  }
  .cat-list a {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    height: 100%;
    min-height: 56px;
    box-sizing: border-box;
    padding: var(--s-2) var(--s-3);
    border-radius: 14px;
    background: var(--c-bg);
    text-decoration: none;
    transition: background-color 120ms ease-out, box-shadow 120ms ease-out;
  }
  .cat-list a:hover,
  .cat-list a:focus-visible {
    background: var(--c-surface);
    box-shadow: 0 0 0 2px var(--c-primary);
    text-decoration: none;
  }
  .cat-icon {
    display: flex;
    flex: 0 0 40px;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--c-surface);
    font-size: 20px;
  }
  .cat-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .cat-name {
    color: var(--c-ink);
    font: 800 15px/20px var(--font-sans);
  }
  .cat-line {
    overflow: hidden;
    color: var(--c-ink-2);
    font: 400 13px/18px var(--font-sans);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* Top 5 in two columns, numbered down then across (1 2 3 | 4 5), like the category cards above (owner, 11 Nov). */
  .about-side .top-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 600px) {
    .about-side .top-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(3, auto);
      grid-auto-flow: column;
    }
  }
  .about-side .top-list li {
    margin: 0;
  }
  /* Same box as the category cards above, so both lists share one left edge. */
  .top-list a {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 56px;
    box-sizing: border-box;
    padding: var(--s-2) var(--s-3);
    border-radius: 14px;
    background: var(--c-bg);
    text-decoration: none;
    transition: background-color 120ms ease-out, box-shadow 120ms ease-out;
  }
  .top-list a:hover,
  .top-list a:focus-visible {
    background: var(--c-surface);
    box-shadow: 0 0 0 2px var(--c-primary);
    text-decoration: none;
  }
  .top-rank {
    display: flex;
    flex: 0 0 28px;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--c-primary);
    color: var(--c-primary-ink);
    font: 800 14px/1 var(--font-sans);
  }
  .top-list img {
    flex: 0 0 40px;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    object-fit: cover;
  }
  .top-name {
    color: var(--c-ink);
    font: 800 15px/20px var(--font-sans);
  }
  .faq-heading {
    padding-top: var(--s-5);
    border-top: 1px solid var(--c-line);
  }
</style>
