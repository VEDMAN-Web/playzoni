---
// Our own simple line icons for the navigation (docs/DESIGN.md §V2.3). 24px grid, drawn with strokes.
interface Props {
  name: 'search' | 'heart' | 'flame' | 'sparkle' | 'grid';
  size?: number;
}

const { name, size = 22 } = Astro.props;
---
<svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'search' && (
    <>
      <circle cx="11" cy="11" r="7" />
      <path d="M20 20l-4-4" />
    </>
  )}
  {name === 'heart' && <path d="M12 20.5s-7.5-4.6-7.5-10A4 4 0 0 1 12 7.8a4 4 0 0 1 7.5 2.7c0 5.4-7.5 10-7.5 10z" />}
  {name === 'flame' && (
    <>
      <path d="M12 3c.6 3.2 4.5 5.1 4.5 9.6a4.5 4.5 0 0 1-9 0c0-1.7.7-2.9 1.6-3.9.2 1.2.8 1.9 1.7 2.1C10.4 8.6 11.2 5.7 12 3z" />
      <path d="M12 21a2.2 2.2 0 0 1-2.2-2.2c0-1.1.9-1.9 2.2-3 1.3 1.1 2.2 1.9 2.2 3A2.2 2.2 0 0 1 12 21z" />
    </>
  )}
  {name === 'sparkle' && (
    <>
      <path d="M10 3l1.9 5.1L17 10l-5.1 1.9L10 17l-1.9-5.1L3 10l5.1-1.9L10 3z" />
      <path d="M19 15v6M16 18h6" />
    </>
  )}
  {name === 'grid' && (
    <>
      <rect x="4" y="4" width="6.5" height="6.5" rx="2" />
      <rect x="13.5" y="4" width="6.5" height="6.5" rx="2" />
      <rect x="4" y="13.5" width="6.5" height="6.5" rx="2" />
      <rect x="13.5" y="13.5" width="6.5" height="6.5" rx="2" />
    </>
  )}
</svg>
