---
import SearchPanel from './SearchPanel.astro';

// Floating nav box (DESIGN §Header): logo, search button, favourites button.
// No full-width bar. The search button opens the SearchPanel. Without JS,
// the search button is a plain link to /search.
---
<header class="nav-wrap">
  <nav class="nav-box" aria-label="Site">
    <a class="logo" href="/" aria-label="Playzoni home">
      <img src="/logo.svg" alt="Playzoni" width="90" height="28" />
    </a>
    <div class="nav-actions">
      <a class="icon-btn" href="/search" aria-label="Search games" aria-controls="search-panel" aria-expanded="false" data-search-open>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" /><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </a>
      <a class="icon-btn" href="/favourites" aria-label="Favourites">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-7.5-10A4 4 0 0 1 12 7.8a4 4 0 0 1 7.5 2.7c0 5.4-7.5 10-7.5 10z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
      </a>
    </div>
  </nav>
  <SearchPanel />
</header>

<style>
  .nav-wrap {
    display: contents;
  }
  .nav-box {
    position: fixed;
    top: var(--gap);
    left: var(--gutter);
    z-index: 50;
    display: flex;
    align-items: center;
    gap: var(--s-2);
    height: 56px;
    padding: 0 var(--s-3);
    box-sizing: border-box;
    background: var(--c-surface);
    border-radius: var(--r-card);
    box-shadow: var(--sh-tile);
  }
  .logo {
    display: inline-flex;
    flex: 0 0 auto;
  }
  .logo img {
    display: block;
    height: 28px;
    width: auto;
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--s-1);
  }
  .icon-btn {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-pill);
    color: var(--c-ink);
    text-decoration: none;
  }
  .icon-btn:hover {
    color: var(--c-primary);
    text-decoration: none;
  }
  /* Desktop: 3 cells wide and 1 cell tall. Logo on top, buttons below. */
  @media (min-width: 1024px) {
    .nav-box {
      display: grid;
      grid-template-rows: auto auto;
      justify-items: center;
      align-content: center;
      gap: var(--s-1);
      width: calc(3 * var(--cell) + 2 * var(--gap));
      height: var(--cell);
      padding: var(--s-1) 0;
    }
    .nav-actions {
      justify-self: center;
    }
  }
</style>
