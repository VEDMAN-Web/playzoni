---
import brand from '../../data/brand.json';
import { getPublishedCategories } from '../lib/published';

// Site footer (docs/DESIGN.md §V2.6, layout from §V2.11): white, with a slanted top edge, content centred (max 1240px).
// Left: logo, tagline, one line about the site and social buttons (only for addresses filled in data/brand.json).
// Right: link columns (popular categories in two short columns, Explore, Help and support, Playzoni).
// Bottom bar: "© year Playzoni" and a back-to-top link.
// Only published categories are linked (at least 12 games).
const popular = (await getPublishedCategories())
  .filter((c) => c.navOrder !== null)
  .sort((a, b) => (a.navOrder ?? 0) - (b.navOrder ?? 0))
  .slice(0, 8);

const socialLinks = [
  { key: 'youtube', label: 'YouTube', url: brand.social.youtube },
  { key: 'instagram', label: 'Instagram', url: brand.social.instagram },
  { key: 'x', label: 'X', url: brand.social.x },
  { key: 'tiktok', label: 'TikTok', url: brand.social.tiktok },
  { key: 'facebook', label: 'Facebook', url: brand.social.facebook },
].filter((s) => s.url.startsWith('https://'));

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="inner">
    <div class="brand">
      <a class="logo" href="/" aria-label="Playzoni home"><img src="/logo.svg" alt="Playzoni" width="112" height="35" /></a>
      <p class="tagline">Play free games instantly.</p>
      <p class="blurb">Free browser games, checked on phones and computers before they go live. No download, no account.</p>
      {socialLinks.length > 0 && (
        <ul class="social" aria-label="Playzoni on social media">
          {socialLinks.map((s) => (
            <li>
              <a class="social-btn" href={s.url} rel="noopener" aria-label={s.label}>
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {s.key === 'youtube' && (
                    <>
                      <rect x="3" y="6" width="18" height="12" rx="4" />
                      <path d="M10 9.5v5l4.5-2.5z" fill="currentColor" />
                    </>
                  )}
                  {s.key === 'instagram' && (
                    <>
                      <rect x="4" y="4" width="16" height="16" rx="5" />
                      <circle cx="12" cy="12" r="3.6" />
                      <circle cx="17" cy="7" r="0.8" fill="currentColor" />
                    </>
                  )}
                  {s.key === 'x' && <path d="M5 5l14 14M19 5L5 19" />}
                  {s.key === 'tiktok' && <path d="M14 4v10.5a3.5 3.5 0 1 1-3.5-3.5M14 4c.4 2.3 2 3.8 4.5 4" />}
                  {s.key === 'facebook' && <path d="M14 20v-7h2.5l.5-3h-3V8.5c0-.9.4-1.5 1.5-1.5H17V4.2A15 15 0 0 0 15 4c-2.3 0-4 1.4-4 4v2H8.5v3H11v7z" />}
                </svg>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <nav class="col col-popular" aria-labelledby="footer-popular">
      <h2 id="footer-popular">Popular categories</h2>
      <ul>
        {popular.map((c) => (
          <li><a href={`/${c.slug}`}>{c.name}</a></li>
        ))}
      </ul>
    </nav>
    <nav class="col" aria-labelledby="footer-explore">
      <h2 id="footer-explore">Explore</h2>
      <ul>
        <li><a href="/new-games">New Games</a></li>
        <li><a href="/popular-games">Popular Games</a></li>
        <li><a href="/categories">All Categories</a></li>
        <li><a href="/all-games">All Games A to Z</a></li>
      </ul>
    </nav>
    <nav class="col" aria-labelledby="footer-help">
      <h2 id="footer-help">Help and support</h2>
      <ul>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
        <li><a href="/cookies">Cookies</a></li>
      </ul>
    </nav>
    <nav class="col" aria-labelledby="footer-about">
      <h2 id="footer-about">Playzoni</h2>
      <ul>
        <li><a href="/about">About us</a></li>
        <li><a href="/developers">For developers</a></li>
      </ul>
    </nav>
  </div>
  <div class="bottom">
    <p class="copy">© {year} Playzoni. All rights reserved.</p>
    <a class="to-top" href="#top">
      Back to top
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6" /></svg>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--s-6);
    padding: 96px var(--gutter) var(--s-5);
    background: var(--c-surface);
    clip-path: polygon(0 48px, 100% 0, 100% 100%, 0 100%);
    color: var(--c-ink);
  }
  .inner,
  .bottom {
    max-width: 1240px;
    margin: 0 auto;
  }
  .inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--s-5);
  }
  .brand,
  .col-popular {
    grid-column: 1 / -1;
  }
  @media (min-width: 768px) {
    .inner {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .col-popular {
      grid-column: 1 / 2;
    }
  }
  @media (min-width: 1024px) {
    .inner {
      grid-template-columns: 1.5fr 1.6fr repeat(3, minmax(0, 1fr));
      gap: var(--s-5) var(--s-6);
    }
    .brand {
      grid-column: auto;
    }
    .col-popular {
      grid-column: auto;
    }
  }
  .logo {
    display: inline-flex;
  }
  .logo img {
    display: block;
    height: 34px;
    width: auto;
  }
  .tagline {
    margin: var(--s-3) 0 var(--s-1);
    color: var(--c-ink);
    font: 800 16px/24px var(--font-sans);
  }
  .blurb {
    max-width: 320px;
    margin: 0 0 var(--s-4);
    color: var(--c-ink-2);
    font: 400 14px/22px var(--font-sans);
  }
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--c-ink);
    color: var(--c-primary-ink);
    transition: background-color 120ms ease-out;
  }
  .social-btn:hover,
  .social-btn:focus-visible {
    background: var(--c-primary);
    color: var(--c-primary-ink);
  }
  /* Small grey capital headings, bold dark links on 36px lines. */
  h2 {
    margin: 0 0 var(--s-2);
    color: var(--c-ink-2);
    font: 700 13px/20px var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Popular categories: two short columns side by side. */
  .col-popular ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--s-4);
  }
  .col a {
    position: relative;
    display: inline-block;
    min-width: 44px; /* e2e: short links such as "Terms" keep a 44px tap target */
    color: var(--c-ink);
    font: 700 15px/36px var(--font-sans);
    text-decoration: none;
    transition: color 120ms ease-out;
  }
  /* The visible line is 36px; this widens the tap area to 44px. */
  .col a::after {
    content: '';
    position: absolute;
    inset: -4px 0;
  }
  .col a:hover,
  .col a:focus-visible {
    color: var(--c-primary);
    text-decoration: none;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: 1px solid var(--c-line);
  }
  .copy {
    margin: 0;
    color: var(--c-ink-2);
    font: var(--t-small);
  }
  .to-top {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 var(--s-4);
    border-radius: var(--r-pill);
    background: var(--c-bg);
    color: var(--c-ink);
    font: 800 14px/1 var(--font-sans);
    text-decoration: none;
    transition: background-color 120ms ease-out, color 120ms ease-out;
  }
  .to-top:hover,
  .to-top:focus-visible {
    background: var(--c-primary);
    color: var(--c-primary-ink);
    text-decoration: none;
  }
</style>
