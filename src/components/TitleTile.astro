---
// Title tile for grid pages (docs/DESIGN.md §V2.3). Goes in the "lead" slot of GameGrid, right after the nav box:
// a white tile one cell wide and four cells tall, in the first column under the nav box, holding the breadcrumbs
// and the page's only H1. Below 1024px it is a plain block above the tiles.
interface Props {
  crumbs: { name: string; path: string }[];
  h1: string;
}

const { crumbs, h1 } = Astro.props;
---
<div class="title-tile">
  <nav class="crumbs" aria-label="Breadcrumb">
    <ol>
      {crumbs.map((c, i) => (
        <li>
          {i === crumbs.length - 1 ? (
            <span aria-current="page">{c.name}</span>
          ) : (
            <>
              <a href={c.path}>{c.name}</a>
              <span aria-hidden="true">›</span>
            </>
          )}
        </li>
      ))}
    </ol>
  </nav>
  <h1 class="page-title">{h1}</h1>
</div>

<style>
  .title-tile {
    grid-column: 1 / -1;
    min-width: 0;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    list-style: none;
    margin: var(--s-4) 0 var(--s-2);
    padding: 0;
    color: var(--c-ink);
    font: var(--t-small);
  }
  .crumbs li {
    display: inline-flex;
    gap: var(--s-1);
    align-items: center;
  }
  .crumbs a {
    color: var(--c-ink);
  }
  .page-title {
    margin: 0 0 var(--s-3);
    color: var(--c-ink);
    font: var(--t-h1);
  }
  @media (min-width: 1024px) {
    .title-tile {
      grid-column: 1;
      grid-row: 2 / span 4;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      padding: var(--s-4);
      box-sizing: border-box;
      border-radius: var(--r-card);
      background: var(--c-surface);
      box-shadow: var(--sh-tile);
    }
    /* 98px of text width: a smaller H1 and words that may break so long names never spill out. */
    .page-title {
      margin: 0;
      font: 800 18px/22px var(--font-sans);
      overflow-wrap: anywhere;
    }
    .crumbs ol {
      margin: 0 0 var(--s-2);
      font-size: 12px;
      line-height: 16px;
    }
  }
</style>
