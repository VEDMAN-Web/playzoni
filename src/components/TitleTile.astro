---
// Title tile for grid pages (docs/DESIGN.md §V2.3). Goes in the "lead" slot of GameGrid, right after the nav box:
// a white tile 3 cells wide and 1 tall (2 wide on the categories page) right after the nav box, holding the
// breadcrumbs and the page's only H1 (Q16 answer, R23). Below 1024px it is a plain block above the tiles.
interface Props {
  crumbs: { name: string; path: string }[];
  h1: string;
  /** Width in cells from 1024px: 3 on category and list pages, 2 on the categories page. */
  span?: 2 | 3 | 4;
}

// Compact by default (owner, 11 Nov, DESIGN §V2.11): 2 cells for short titles like "Action Games", 3 for longer ones,
// 4 only for very long ones.
const { crumbs, h1, span = h1.length <= 18 ? 2 : h1.length <= 40 ? 3 : 4 } = Astro.props;
---
<div class={`title-tile span-${span}`} style={`--chars: ${h1.length}`}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <ol>
      {crumbs.map((c, i) => (
        <li>
          {i === crumbs.length - 1 ? (
            <span aria-current="page">{c.name}</span>
          ) : (
            <>
              <a href={c.path}>{c.name}</a>
              <span aria-hidden="true">›</span>
            </>
          )}
        </li>
      ))}
    </ol>
  </nav>
  <h1 class="page-title">{h1}</h1>
</div>

<style>
  .title-tile {
    grid-column: 1 / -1;
    min-width: 0;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    list-style: none;
    margin: var(--s-4) 0 var(--s-2);
    padding: 0;
    color: var(--c-ink);
    font: var(--t-small);
  }
  .crumbs li {
    display: inline-flex;
    gap: var(--s-1);
    align-items: center;
  }
  .crumbs a {
    color: var(--c-ink);
  }
  .page-title {
    margin: 0 0 var(--s-3);
    color: var(--c-ink);
    font: var(--t-h1);
  }
  @media (min-width: 1024px) {
    .title-tile {
      grid-column: span 3;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 10px 14px;
      box-sizing: border-box;
      border-radius: var(--r-card);
      background: var(--c-surface);
      box-shadow: var(--sh-tile);
      container-type: inline-size;
    }
    .title-tile.span-2 {
      grid-column: span 2;
    }
    .title-tile.span-4 {
      grid-column: span 4;
    }
    .page-title {
      display: -webkit-box;
      margin: 0;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      font: 800 19px/23px var(--font-sans);
      /* The title grows to fill the tile's width (owner, 11 Nov: no empty space after short names); long titles
         stay at 19px and wrap to two lines. 0.7em is a safe letter width for Nunito 800 (no JS); the script below then sizes it exactly. */
      font-size: clamp(19px, calc(100cqi / (var(--chars) * 0.7)), 32px);
      line-height: 1.15;
      overflow-wrap: break-word;
    }
    .crumbs ol {
      margin: 0 0 4px;
      flex-wrap: nowrap;
      overflow: hidden;
      color: var(--c-ink-2);
      font: 600 12px/14px var(--font-sans);
      white-space: nowrap;
    }
    .crumbs a {
      color: var(--c-ink-2);
    }
  }
</style>

<script>
  // Exact fit (owner, 11 Nov): from 1024px, grow the title to fill one line of the tile, 19px to 32px. If even 19px
  // does not fit on one line, keep the CSS size and let it wrap to two lines.
  const fit = (): void => {
    for (const h1 of document.querySelectorAll<HTMLElement>('.title-tile .page-title')) {
      h1.style.removeProperty('font-size');
      h1.style.removeProperty('white-space');
      if (!window.matchMedia('(min-width: 1024px)').matches) continue;
      h1.style.whiteSpace = 'nowrap';
      const base = parseFloat(getComputedStyle(h1).fontSize);
      const words = document.createRange();
      words.selectNodeContents(h1);
      const textWidth = words.getBoundingClientRect().width;
      if (textWidth === 0) continue;
      const size = Math.min(32, Math.floor(base * (h1.clientWidth / textWidth) * 0.98));
      if (size >= 19) h1.style.fontSize = `${size}px`;
      else h1.style.removeProperty('white-space');
    }
  };
  void document.fonts.ready.then(fit);
  window.addEventListener('resize', fit, { passive: true });
</script>
