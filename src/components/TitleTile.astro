---
// Title tile for grid pages (docs/DESIGN.md §V2.3). Goes in the "lead" slot of GameGrid, right after the nav box:
// a white tile 3 cells wide and 1 tall (2 wide on the categories page) right after the nav box, holding the
// breadcrumbs and the page's only H1 (Q16 answer, R23). Below 1024px it is a plain block above the tiles.
interface Props {
  crumbs: { name: string; path: string }[];
  h1: string;
  /** Width in cells from 1024px: 3 on category and list pages, 2 on the categories page. */
  span?: 2 | 3 | 4;
}

// A title of more than about 48 characters needs more than two lines in a 3-cell tile, so it gets 4 cells (DESIGN §V2.10).
const { crumbs, h1, span = h1.length > 48 ? 4 : 3 } = Astro.props;
---
<div class={`title-tile span-${span}`}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <ol>
      {crumbs.map((c, i) => (
        <li>
          {i === crumbs.length - 1 ? (
            <span aria-current="page">{c.name}</span>
          ) : (
            <>
              <a href={c.path}>{c.name}</a>
              <span aria-hidden="true">›</span>
            </>
          )}
        </li>
      ))}
    </ol>
  </nav>
  <h1 class="page-title">{h1}</h1>
</div>

<style>
  .title-tile {
    grid-column: 1 / -1;
    min-width: 0;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    list-style: none;
    margin: var(--s-4) 0 var(--s-2);
    padding: 0;
    color: var(--c-ink);
    font: var(--t-small);
  }
  .crumbs li {
    display: inline-flex;
    gap: var(--s-1);
    align-items: center;
  }
  .crumbs a {
    color: var(--c-ink);
  }
  .page-title {
    margin: 0 0 var(--s-3);
    color: var(--c-ink);
    font: var(--t-h1);
  }
  @media (min-width: 1024px) {
    .title-tile {
      grid-column: span 3;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 10px 16px;
      box-sizing: border-box;
      border-radius: var(--r-card);
      background: var(--c-surface);
      box-shadow: var(--sh-tile);
    }
    .title-tile.span-2 {
      grid-column: span 2;
    }
    .title-tile.span-4 {
      grid-column: span 4;
    }
    .page-title {
      display: -webkit-box;
      margin: 0;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      font: 800 20px/24px var(--font-sans);
      overflow-wrap: anywhere;
    }
    .crumbs ol {
      margin: 0 0 2px;
      font: 600 12px/14px var(--font-sans);
    }
  }
</style>
