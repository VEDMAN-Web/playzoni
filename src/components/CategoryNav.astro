---
import categories from '../../data/categories.json';

// Main nav: the 12 categories with a navOrder. A category shows only when it has
// 12 or more published games, unless sample games are on (then all 12 show).
interface Props {
  activeSlug?: string;
  showAll: boolean;
  counts: Record<string, number>;
}

const { activeSlug, showAll, counts } = Astro.props;

const navItems = categories
  .filter((c) => c.navOrder !== null)
  .sort((a, b) => (a.navOrder ?? 0) - (b.navOrder ?? 0))
  .filter((c) => showAll || (counts[c.slug] ?? 0) >= 12);
---
{
  navItems.length > 0 && (
    <nav class="cat-nav" aria-label="Categories">
      <ul>
        {navItems.map((c) => {
          const active = c.slug === activeSlug;
          return (
            <li>
              <a href={`/${c.slug}`} class:list={['chip', { active }]} aria-current={active ? 'page' : undefined}>
                {c.shortName}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  )
}

<style>
  .cat-nav {
    border-top: 1px solid var(--c-line);
  }
  .cat-nav ul {
    display: flex;
    gap: var(--s-2);
    overflow-x: auto;
    scrollbar-width: none;
    list-style: none;
    margin: 0;
    /* Vertical padding leaves room for the 44px tap area around each 36px chip. */
    padding: 4px var(--gutter);
  }
  .cat-nav ul::-webkit-scrollbar {
    display: none;
  }
  .cat-nav li {
    flex: 0 0 auto;
  }
  .chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 var(--s-3);
    border: 1px solid var(--c-line);
    border-radius: var(--r-pill);
    background: var(--c-surface);
    color: var(--c-ink);
    font: var(--t-small);
    white-space: nowrap;
    text-decoration: none;
  }
  /* Extends the tap area to 44px without changing the visible 36px chip. */
  .chip::after {
    content: '';
    position: absolute;
    inset: -4px 0;
  }
  .chip:hover {
    border-color: var(--c-primary);
    color: var(--c-primary);
    text-decoration: none;
  }
  .chip.active {
    background: var(--c-primary);
    border-color: var(--c-primary);
    color: var(--c-primary-ink);
  }
  @media (min-width: 768px) {
    .cat-nav ul {
      flex-wrap: wrap;
      justify-content: center;
      overflow-x: visible;
    }
  }
</style>
