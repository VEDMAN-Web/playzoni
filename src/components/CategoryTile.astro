---
// Category tile (docs/DESIGN.md §V2.8 and §V2.10): 2 cells wide (204px), 1 cell tall, white, radius 16, padding 12px.
// On the left a 56x56 picture with radius 12: the thumbnail of the category's most popular published game; only if the
// category has no game picture, the emoji on a rounded square instead. The name is on the right in UPPERCASE, 13px,
// weight 800, at most 2 lines. The whole tile is a link.
interface Props {
  slug: string;
  shortName: string;
  emoji: string;
  /** Slug of the game whose thumbnail is shown. */
  imageSlug?: string;
}

const { slug, shortName, emoji, imageSlug } = Astro.props;
---
<a class="cat-tile" href={`/${slug}`}>
  {imageSlug ? (
    <img class="pic" src={`/thumbs/${imageSlug}/s.webp`} width="56" height="56" alt="" loading="lazy" decoding="async" />
  ) : (
    <span class="pic emoji" aria-hidden="true">{emoji}</span>
  )}
  <span class="name">{shortName}<span class="sr-only"> games</span></span>
</a>

<style>
  .cat-tile {
    display: flex;
    align-items: center;
    gap: 12px;
    box-sizing: border-box;
    height: 100%;
    padding: 12px;
    border-radius: var(--r-tile);
    background: var(--c-surface);
    box-shadow: var(--sh-tile);
    color: var(--c-ink);
    text-decoration: none;
    transition: transform 180ms var(--ease-tile), box-shadow 180ms var(--ease-tile);
  }
  @media (hover: hover) and (pointer: fine) {
    .cat-tile:hover,
    .cat-tile:focus-visible {
      transform: translateY(-4px) scale(1.04);
      box-shadow: var(--sh-tile-hover);
      color: var(--c-ink);
      text-decoration: none;
    }
  }
  .pic {
    display: block;
    flex: 0 0 auto;
    width: 56px;
    height: 56px;
    border-radius: 12px;
    object-fit: cover;
  }
  .emoji {
    display: grid;
    place-items: center;
    background: var(--c-bg);
    font-size: 28px;
    line-height: 1;
  }
  .name {
    display: -webkit-box;
    min-width: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font: 800 13px/16px var(--font-sans);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .cat-tile:hover,
    .cat-tile:focus-visible {
      transform: none;
    }
  }
</style>
