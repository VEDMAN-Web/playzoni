---
// Home "Show more games" (owner, 11 Nov 2026): under the mosaic, each press adds the next most popular games that are
// not on the page yet, 4 full rows at a time. With JavaScript off the button is a plain link to /popular-games.
// When every game is shown, the button becomes a link to the A to Z list.
---
<section class="show-more" aria-label="More games" data-show-more>
  <div class="pz-grid more-grid" data-more-grid hidden></div>
  <a class="more-btn" href="/popular-games" data-more-btn>
    <span data-more-label>Show more games</span>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
  </a>
</section>

<style>
  .show-more {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap);
    margin-top: var(--gap);
  }
  .more-grid {
    width: 100%;
  }
  .more-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 22px 0 26px;
    border-radius: var(--r-pill);
    background: var(--c-surface);
    color: var(--c-ink);
    font: 800 16px/1 var(--font-sans);
    text-decoration: none;
    box-shadow: var(--sh-tile);
    transition: background-color 120ms ease-out, color 120ms ease-out, transform 120ms ease-out;
  }
  .more-btn:hover {
    background: var(--c-primary);
    color: var(--c-primary-ink);
    transform: translateY(-1px);
  }
  .more-btn:focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: 3px;
  }
  .more-btn[aria-busy='true'] {
    opacity: 0.7;
  }
  .more-btn.is-done svg {
    transform: rotate(-90deg);
  }
</style>

<script>
  import { loadIndex, rowTile } from '../lib/render-tiles';
  import '../styles/client-tiles.css';

  const ROWS = 4;
  const root = document.querySelector<HTMLElement>('[data-show-more]');
  const grid = root?.querySelector<HTMLElement>('[data-more-grid]');
  const button = root?.querySelector<HTMLAnchorElement>('[data-more-btn]');
  const label = root?.querySelector<HTMLElement>('[data-more-label]');

  // Games already on the page (mosaic, rows, earlier presses) are not added again.
  const shownSlugs = (): Set<string> =>
    new Set([...document.querySelectorAll<HTMLElement>('main [data-slug]')].map((el) => el.dataset.slug ?? ''));

  // Columns of the grid, so every press adds whole rows.
  const columns = (): number => {
    const style = getComputedStyle(grid!);
    const cell = parseFloat(style.getPropertyValue('--cell')) || 94;
    const gap = parseFloat(style.columnGap) || 12;
    return Math.max(1, Math.floor((grid!.clientWidth + gap) / (cell + gap)));
  };

  const finish = (): void => {
    button!.href = '/all-games';
    button!.classList.add('is-done');
    label!.textContent = 'See all games A to Z';
    button!.dataset.done = 'true';
  };

  button?.addEventListener('click', async (event) => {
    if (button.dataset.done === 'true') return; // a normal link now
    event.preventDefault();
    if (button.getAttribute('aria-busy') === 'true') return;
    button.setAttribute('aria-busy', 'true');
    grid!.hidden = false;
    const index = await loadIndex();
    const shown = shownSlugs();
    const next = index.filter((g) => !shown.has(g.slug)).slice(0, columns() * ROWS);
    for (const game of next) grid!.appendChild(rowTile(game));
    button.removeAttribute('aria-busy');
    if (next.length === 0 && grid!.children.length === 0) grid!.hidden = true;
    if (index.filter((g) => !shownSlugs().has(g.slug)).length === 0) finish();
  });
</script>
