---
import { categoryPictures } from '../lib/category-image';
import GameGrid, { type GridItem } from './GameGrid.astro';
import GameRow from './GameRow.astro';
import { getPublishedGames } from '../lib/games';
import { publishedCategoriesFrom } from '../lib/published';

// The rows block shared by the home page and every category page (DESIGN §V2.13): Popular games, New games, one row
// per top-8 category (minus the category being shown), then "Browse by category". Every row starts with 15 tiles
// and loads more as the visitor scrolls to its end (GameRow `more`).
interface Props {
  /** On a category page: that category's slug, so it does not get its own row. */
  excludeCategory?: string;
}

const { excludeCategory } = Astro.props;

const games = await getPublishedGames();
const published = publishedCategoriesFrom(games);
const pictures = categoryPictures(games, published);

const toRow = (list: typeof games) => list.slice(0, 15).map((g) => ({ title: g.data.title, slug: g.data.slug }));
const byPopularity = [...games].sort((a, b) => b.data.popularity - a.data.popularity);
const byNew = [...games].sort(
  (a, b) => b.data.addedDate.valueOf() - a.data.addedDate.valueOf() || b.data.popularity - a.data.popularity,
);

// Popular and New never repeat each other (owner, 11 Nov): New skips Popular's first 15. In the browser the rows
// also skip games in "Recently played" and keep each other's endless loads apart (GameRow `dedupe`).
const popularRow = toRow(byPopularity);
const inPopular = new Set(popularRow.map((g) => g.slug));
const newRow = toRow(byNew.filter((g) => !inPopular.has(g.data.slug)));
const categoryRows = published
  .filter((c) => c.navOrder !== null && c.navOrder <= 8 && c.slug !== excludeCategory)
  .sort((a, b) => (a.navOrder ?? 0) - (b.navOrder ?? 0))
  .map((c) => ({ category: c, games: toRow(byPopularity.filter((g) => g.data.categories.includes(c.slug))) }))
  .filter((r) => r.games.length > 0);

const browseItems: GridItem[] = published.map((c) => ({
  kind: 'category' as const,
  slug: c.slug,
  shortName: c.shortName,
  emoji: c.emoji,
  imageSlug: pictures.get(c.slug),
}));
---
{popularRow.length > 0 && <GameRow title="Popular games" seeAllHref="/popular-games" games={popularRow} more="popular" dedupe />}
{newRow.length > 0 && <GameRow title="New games" seeAllHref="/new-games" games={newRow} more="new" dedupe />}
{categoryRows.map((r) => (
  <GameRow title={r.category.name} seeAllHref={`/${r.category.slug}`} games={r.games} more={`cat:${r.category.slug}`} />
))}

<section class="browse" aria-labelledby="browse-heading">
  <h2 id="browse-heading" class="block-heading">Browse by category</h2>
  <GameGrid items={browseItems} mode="uniform" uniformSize="S" wide={true} label="All categories" />
</section>

<style>
  .browse {
    margin: var(--s-6) auto;
  }
  .block-heading {
    margin: 0 0 var(--s-3);
    color: var(--c-ink);
    font: var(--t-h2);
  }
</style>
