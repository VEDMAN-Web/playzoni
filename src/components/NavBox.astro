---
import NavIcon from './NavIcon.astro';

// The nav box (docs/DESIGN.md §V2.3, size from §V2.10, layout from §V2.11): a 2x1 (204x94) white tile on desktop
// (1024px and up). Logo centred on the top line; under it one row of equal, soft-blue rounded buttons: search,
// favourites, categories. It is the first item of the grid and scrolls with the page. Below 1024px it is hidden; the
// top bar in Header takes over. Without JavaScript the search button is a plain link to /search.
---
<nav class="nav-box" aria-label="Site">
  <a class="logo" href="/" aria-label="Playzoni home">
    <img src="/logo.svg" alt="Playzoni" width="96" height="30" />
  </a>
  <div class="actions">
    <a class="icon-btn" href="/search" aria-label="Search games" title="Search" aria-controls="search-panel" aria-expanded="false" data-search-open>
      <NavIcon name="search" />
    </a>
    <a class="icon-btn" href="/favourites" aria-label="Favourites" title="Favourites">
      <NavIcon name="heart" />
    </a>
    <a class="icon-btn" href="/categories" aria-label="All categories" title="Categories">
      <NavIcon name="grid" />
    </a>
    <a class="icon-btn" href="/favourites" aria-label="Your games" aria-controls="profile-panel" aria-expanded="false" data-profile-open>
      <NavIcon name="smile" />
    </a>
  </div>
</nav>

<style>
  .nav-box {
    display: none;
  }
  @media (min-width: 1024px) {
    .nav-box {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: space-between;
      gap: var(--s-2);
      width: 100%;
      height: 100%;
      box-sizing: border-box;
      padding: 12px;
      border-radius: var(--r-card);
      background: var(--c-surface);
      box-shadow: var(--sh-tile);
    }
  }
  .logo {
    display: flex;
    justify-content: center;
    align-items: center;
    flex: 1 1 auto;
    min-height: 0;
  }
  .logo img {
    display: block;
    width: auto;
    height: 28px;
  }
  .actions {
    display: flex;
    gap: var(--s-2);
  }
  /* 36px tall on a 94px tile; the hit area is widened to 44px with ::after. */
  .icon-btn {
    position: relative;
    display: inline-flex;
    flex: 1 1 0;
    align-items: center;
    justify-content: center;
    height: 36px;
    border-radius: 12px;
    background: var(--c-bg);
    color: var(--c-ink);
    text-decoration: none;
    transition: background-color 120ms ease-out, color 120ms ease-out, transform 120ms ease-out;
  }
  .icon-btn::after {
    content: '';
    position: absolute;
    inset: -4px 0;
  }
  .icon-btn :global(svg) {
    width: 20px;
    height: 20px;
  }
  .icon-btn:hover,
  .icon-btn:focus-visible {
    background: var(--c-primary);
    color: var(--c-primary-ink);
    text-decoration: none;
  }
  .icon-btn:active {
    transform: scale(0.95);
  }
  @media (prefers-reduced-motion: reduce) {
    .icon-btn:active {
      transform: none;
    }
  }
</style>
