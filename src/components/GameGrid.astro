---
import GameTile from './GameTile.astro';
import CategoryTile from './CategoryTile.astro';
import NavBox from './NavBox.astro';
import type { BadgeKind } from '../lib/badges';
import { capBadges, placeItems } from '../lib/mosaic';

// Game grid (docs/DESIGN.md §V2.2). Tile sizes: S = 1x1, L = 2x2, XL = 3x3. Two modes:
// - mosaic (home, category page 1): after the nav box, positions 3 and 16 of every 24 tiles are L, the rest S.
//   Featured games fill the L slots first. With xlFirst, the first featured game is XL (3x3 from 1024px, 2x2 below).
// - uniform (rows, related, lists): every tile has the same size (S, or L when uniformSize is 'L').
// Category tiles are 2x1 and take one slot in order. At most 12 badges are drawn on one grid (see capBadges).
// The nav box (1x1, desktop only) is the first grid item on pages that use it (DESIGN §V2.3). The optional "lead"
// slot comes right after it (for example the title tile on category pages).

export interface GridGame {
  kind: 'game';
  title: string;
  slug: string;
  featured?: boolean;
  badge?: BadgeKind;
  previewVideo?: string;
  screenshots?: string[];
}
export interface GridCategory {
  kind: 'category';
  slug: string;
  shortName: string;
  emoji: string;
  /** Slug of the category's most popular game; its thumbnail is the tile picture (DESIGN §V2.8). */
  imageSlug?: string;
}
export type GridItem = GridGame | GridCategory;

interface Props {
  items: GridItem[];
  mode?: 'mosaic' | 'uniform';
  uniformSize?: 'S' | 'L';
  navBox?: boolean;
  eagerCount?: number;
  label?: string;
  xlFirst?: boolean;
  /** The first tile loads with high priority (the LCP picture on grid pages). False on the game page, where the player cover is the LCP. */
  priorityFirst?: boolean;
  /** R39: extra 1x1 games (not part of this list) rendered hidden after the tiles; the fit script shows just enough of
      them to complete the bottom row. Not part of the page's ItemList. */
  fillers?: { title: string; slug: string }[];
  /** For pages made only of 2x1 tiles (the categories page): columns are 2 cells wide and stretch to fill the row, so an odd number of cell columns never leaves a hole. */
  wide?: boolean;
}

const { items, mode = 'mosaic', uniformSize = 'S', navBox = false, eagerCount = 6, label = 'Games', xlFirst = false, priorityFirst = true, wide = false, fillers = [] } = Astro.props;

const placed = placeItems(capBadges(items), { mode, uniformSize, xlFirst });
---
<div class={`grid grid-${mode}${wide ? ' grid-wide' : ''}`} role="group" aria-label={label}>
  {navBox && <div class="cell cell-nav"><NavBox /></div>}
  <slot name="lead" />
  {placed.map((p, i) => (
    <div class={`cell cell-${p.size.toLowerCase()}`}>
      {p.item.kind === 'category' ? (
        <CategoryTile slug={p.item.slug} shortName={p.item.shortName} emoji={p.item.emoji} imageSlug={p.item.imageSlug} />
      ) : (
        <GameTile
          title={p.item.title}
          slug={p.item.slug}
          size={p.size === 'CAT' ? 'S' : p.size}
          eager={i < eagerCount}
          priority={priorityFirst && i === 0}
          badge={p.item.badge}
          previewVideo={p.item.previewVideo}
          screenshots={p.item.screenshots}
        />
      )}
    </div>
  ))}
  {mode === 'mosaic' && fillers.map((f) => (
    <div class="cell cell-s cell-fill" hidden data-fill>
      <GameTile title={f.title} slug={f.slug} size="S" />
    </div>
  ))}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, var(--cell));
    grid-auto-rows: var(--cell);
    grid-auto-flow: dense;
    justify-content: center;
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* The nav box is a desktop tile; below 1024px the top bar in Header is used and this cell is not drawn. */
  .cell-nav {
    display: none;
    grid-column: span 2;
    grid-row: span 1;
  }
  @media (min-width: 1024px) {
    .cell-nav {
      display: block;
    }
  }
  .cell {
    min-width: 0;
  }
  .cell > :global(*) {
    height: 100%;
  }
  .cell-s {
    grid-column: span 1;
    grid-row: span 1;
  }
  .cell-l {
    grid-column: span 2;
    grid-row: span 2;
  }
  /* XL is 3x3 from 1024px; on smaller screens it is drawn as L so it does not fill the width. */
  .cell-xl {
    grid-column: span 2;
    grid-row: span 2;
  }
  @media (min-width: 1024px) {
    .cell-xl {
      grid-column: span 3;
      grid-row: span 3;
    }
  }
  .cell-cat {
    grid-column: span 2;
    grid-row: span 1;
  }
  /* Wide mode: every column is as wide as a 2x1 tile (204px or more), so the nav box, the title tile and the category
     tiles each take exactly one column. */
  .grid-wide {
    grid-template-columns: repeat(auto-fill, minmax(calc(2 * var(--cell) + var(--gap)), 1fr));
  }
  .grid-wide .cell-nav,
  .grid-wide .cell-cat,
  .grid-wide :global(.title-tile.span-2) {
    grid-column: span 1;
  }
</style>

<script>
  // R32: on mosaic grids the last row must be full. This measures the tiles and hides trailing ones that leave
  // empty cells in the last row (src/lib/mosaic-fit.ts). Runs on load and when the window is resized.
  import { fillersNeeded, tilesToHide, type Box } from '../lib/mosaic-fit';

  function fitMosaic(grid: HTMLElement): void {
    for (const el of grid.querySelectorAll<HTMLElement>('[data-fit-hidden]')) {
      el.hidden = false;
      el.removeAttribute('data-fit-hidden');
    }
    const fillers = Array.from(grid.querySelectorAll<HTMLElement>('[data-fill]'));
    for (const el of fillers) el.hidden = true;
    const styles = getComputedStyle(grid);
    const cell = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--cell'));
    const gap = parseFloat(styles.columnGap);
    const cols = styles.gridTemplateColumns.split(' ').filter((t) => t.length > 0).length;
    if (!(cell > 0) || !(gap >= 0) || cols < 1) return;

    const origin = grid.getBoundingClientRect();
    const tiles: HTMLElement[] = [];
    const boxes: Box[] = [];
    for (const el of Array.from(grid.children) as HTMLElement[]) {
      if (el.hidden) continue;
      const r = el.getBoundingClientRect();
      if (r.width === 0 || r.height === 0) continue;
      tiles.push(el);
      boxes.push({
        x: Math.round((r.left - origin.left) / (cell + gap)),
        y: Math.round((r.top - origin.top) / (cell + gap)),
        // At least one cell each way: shorter blocks (the related-category chip strip, 36px) still take a whole row.
        w: Math.max(1, Math.round((r.width + gap) / (cell + gap))),
        h: Math.max(1, Math.round((r.height + gap) / (cell + gap))),
        hideable: el.classList.contains('cell') && !el.classList.contains('cell-nav') && !el.hasAttribute('data-fill'),
      });
    }
    // R39: first try to complete the bottom row with filler games (category pages); otherwise hide trailing tiles.
    const need = fillersNeeded(boxes, cols, fillers.length);
    if (need >= 0) {
      for (const el of fillers.slice(0, need)) el.hidden = false;
      return;
    }
    for (const i of tilesToHide(boxes, cols)) {
      tiles[i].hidden = true;
      tiles[i].setAttribute('data-fit-hidden', '');
    }
  }

  function fitAll(): void {
    for (const grid of document.querySelectorAll<HTMLElement>('.grid-mosaic')) fitMosaic(grid);
  }

  let frame = 0;
  window.addEventListener('resize', () => {
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(fitAll);
  });
  fitAll();
</script>

